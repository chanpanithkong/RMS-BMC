APP_NAME=Restaurant Management System
APP_ENV=development
DEBUG=true

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD
DB_NAME=restaurant_management_db

# ${DB_PASSWORD} is substituted from DB_PASSWORD at startup.
# In Docker Compose the host is the service name "db", not localhost.
DATABASE_URL=postgresql+psycopg://postgres:${DB_PASSWORD}@localhost:5432/restaurant_management_db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=GENERATE_A_SECURE_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

FRONTEND_URL=http://localhost:3000
# Optional. When set, WebSocket events are shared across API workers and Celery uses it as broker.
REDIS_URL=

# Online ordering. No real payment provider is integrated yet (SRS V-06).
# "sandbox" is a test gateway for development only; it is refused when APP_ENV=production.
PAYMENT_GATEWAY=
PAYMENT_SANDBOX_SECRET=
PUBLIC_RATE_LIMIT_PER_MINUTE=60
