APP_NAME=Restaurant Management System
APP_ENV=development
DEBUG=true

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD
DB_NAME=restaurant_management_db

# ${DB_PASSWORD} is substituted from DB_PASSWORD at startup.
# In Docker Compose the host is the service name "db", not localhost.
DATABASE_URL=postgresql+psycopg://postgres:${DB_PASSWORD}@localhost:5432/restaurant_management_db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=GENERATE_A_SECURE_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

FRONTEND_URL=http://localhost:3000
# Optional. When set, WebSocket events are shared across API workers and Celery uses it as broker.
REDIS_URL=

# Online ordering. No real payment provider is integrated yet (SRS V-06).
# "sandbox" is a test gateway for development only; it is refused when APP_ENV=production.
PAYMENT_GATEWAY=
PAYMENT_SANDBOX_SECRET=
PUBLIC_RATE_LIMIT_PER_MINUTE=60

# Bakong KHQR (set PAYMENT_GATEWAY=bakong). Register for an API token on the Bakong Open API site
# (SIT https://sit-api-bakong.nbc.org.kh, production https://api-bakong.nbc.org.kh); tokens expire after 90 days.
BAKONG_API_URL=https://sit-api-bakong.nbc.org.kh
BAKONG_API_TOKEN=
BAKONG_ACCOUNT_ID=
# individual = KHQR tag 29 (Bakong account only); merchant = tag 30 (also needs merchant ID and acquiring bank)
BAKONG_MERCHANT_TYPE=individual
BAKONG_MERCHANT_ID=
BAKONG_ACQUIRING_BANK=
BAKONG_MERCHANT_NAME=
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_MCC=5999
BAKONG_QR_MINUTES=10

# Customer SMS (set SMS_PROVIDER=plasgate). Keys are in your PlasGate account under SMPP & API > SMS Gateway.
# Without a provider, messages are only logged and phone sign-in for online customers is unavailable.
SMS_PROVIDER=
PLASGATE_API_URL=https://cloudapi.plasgate.com
PLASGATE_PRIVATE_KEY=
PLASGATE_SECRET=
PLASGATE_SENDER=

# GrabFood partner integration (GrabFood Partner API v1.1.3). Grab calls RMS with the partner client ID/secret you
# create here and enter in the Grab developer portal; RMS calls Grab with the OAuth client Grab issues to you.
GRABFOOD_PARTNER_CLIENT_ID=
GRABFOOD_PARTNER_CLIENT_SECRET=
GRABFOOD_CLIENT_ID=
GRABFOOD_CLIENT_SECRET=
GRABFOOD_API_URL=https://partner-api.grab.com/grabfood
GRABFOOD_AUTH_URL=https://partner-api.grab.com/grabid/v1/oauth2/token
